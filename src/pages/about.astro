---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const aboutContent = pages.find(p => p.data.order === 1);
const { Content } = await render(aboutContent);
---

<Layout title="关于我们" description="了解晨曦文化教育培训中心的八年教育历程">
  <!-- Hero -->
  <section style="background: linear-gradient(160deg, #1e3a5f 0%, #2563eb 100%); padding: 100px 32px 80px; text-align: center; color: white;">
    <h1 style="font-family: 'Noto Serif SC', serif; font-size: 44px; font-weight: 700; margin-bottom: 16px;">关于晨曦文化</h1>
    <p style="font-size: 17px; opacity: 0.85; max-width: 560px; margin: 0 auto;">八年教育初心，从一间教室到值得信赖的教育品牌</p>
  </section>

  <!-- Content -->
  <section class="section">
    <div class="container" style="max-width: 800px;">
      <div class="prose fade-in">
        <Content />
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section" style="background: white; padding: 80px 0;">
    <div class="container">
      <h2 class="section-title fade-in">我们的价值观</h2>
      <p class="section-subtitle fade-in">以爱育才，以智启航</p>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 900px; margin: 0 auto;">
        <div class="card fade-in" style="text-align: center; padding: 40px 28px;">
          <div style="font-size: 48px; margin-bottom: 20px;">❤️</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px;">真诚</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">用心对待每一位学生和家长，不夸大、不虚假。</p>
        </div>
        <div class="card fade-in" style="text-align: center; padding: 40px 28px;">
          <div style="font-size: 48px; margin-bottom: 20px;">🎯</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px;">专业</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">深耕初高中衔接领域，用教研驱动教学。</p>
        </div>
        <div class="card fade-in" style="text-align: center; padding: 40px 28px;">
          <div style="font-size: 48px; margin-bottom: 20px;">🤝</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px;">陪伴</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">不只是教知识，更是陪伴学生成长的每一步。</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      [style*="grid-template-columns: repeat(3"] { grid-template-columns: 1fr !important; }
    }
  </style>
</Layout>
