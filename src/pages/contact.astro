---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const contactContent = pages.find(p => p.data.order === 3);
const { Content } = await render(contactContent);
---

<Layout title="联系我们" description="衡阳市蒸湘区 · 欢迎来电咨询或到校参观">
  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #1a73e8, #0d47a1); padding: 80px 24px 60px; text-align: center; color: white;">
    <h1 style="font-size: 40px; font-weight: 800; margin-bottom: 12px;">联系我们</h1>
    <p style="font-size: 18px; opacity: 0.85;">欢迎来电咨询或到校参观</p>
  </section>

  <!-- Contact Cards -->
  <section style="padding: 60px 24px; background: #f8f9fa;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
        <!-- Info Side -->
        <div>
          <div class="prose">
            <Content />
          </div>
        </div>

        <!-- Form Side -->
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 40px;">
          <h3 style="font-size: 22px; font-weight: 700; margin-bottom: 24px; color: #1a73e8;">在线留言</h3>
          <form style="display: flex; flex-direction: column; gap: 16px;">
            <div>
              <label style="display: block; font-size: 14px; font-weight: 600; color: #333; margin-bottom: 6px;">学生姓名</label>
              <input type="text" placeholder="请输入学生姓名" style="width: 100%; padding: 12px 16px; border: 1px solid #e0e0e0; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s;" onfocus="this.style.borderColor='#1a73e8'" onblur="this.style.borderColor='#e0e0e0'" />
            </div>
            <div>
              <label style="display: block; font-size: 14px; font-weight: 600; color: #333; margin-bottom: 6px;">联系电话</label>
              <input type="tel" placeholder="请输入联系电话" style="width: 100%; padding: 12px 16px; border: 1px solid #e0e0e0; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s;" onfocus="this.style.borderColor='#1a73e8'" onblur="this.style.borderColor='#e0e0e0'" />
            </div>
            <div>
              <label style="display: block; font-size: 14px; font-weight: 600; color: #333; margin-bottom: 6px;">年级</label>
              <select style="width: 100%; padding: 12px 16px; border: 1px solid #e0e0e0; border-radius: 8px; font-size: 14px; outline: none; background: white;">
                <option value="">请选择年级</option>
                <option value="初一">初一</option>
                <option value="初二">初二</option>
                <option value="初三">初三</option>
                <option value="高一">高一</option>
                <option value="高二">高二</option>
                <option value="高三">高三</option>
              </select>
            </div>
            <div>
              <label style="display: block; font-size: 14px; font-weight: 600; color: #333; margin-bottom: 6px;">留言内容</label>
              <textarea placeholder="请输入您的需求或问题..." rows="4" style="width: 100%; padding: 12px 16px; border: 1px solid #e0e0e0; border-radius: 8px; font-size: 14px; outline: none; resize: vertical; font-family: inherit; transition: border-color 0.2s;" onfocus="this.style.borderColor='#1a73e8'" onblur="this.style.borderColor='#e0e0e0'"></textarea>
            </div>
            <button type="button" style="padding: 14px 32px; background: #1a73e8; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#1558b0'" onmouseout="this.style.background='#1a73e8'">
              提交留言
            </button>
          </form>
          <p style="font-size: 12px; color: #999; margin-top: 12px; text-align: center;">* 提交后我们将在24小时内回复</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    if (window.innerWidth <= 768) {
      const grids = document.querySelectorAll('[style*="grid-template-columns: 1fr 1fr"]');
      grids.forEach(grid => { grid.style.gridTemplateColumns = '1fr'; });
    }
  </script>
</Layout>
