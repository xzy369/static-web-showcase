---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const contactContent = pages.find(p => p.data.order === 3);
const { Content } = await render(contactContent);
---

<Layout title="联系我们" description="衡阳市蒸湘区 · 欢迎来电咨询或到校参观">
  <!-- Hero -->
  <section style="background: linear-gradient(160deg, #1e3a5f 0%, #2563eb 100%); padding: 100px 32px 80px; text-align: center; color: white;">
    <h1 style="font-family: 'Noto Serif SC', serif; font-size: 44px; font-weight: 700; margin-bottom: 16px;">联系我们</h1>
    <p style="font-size: 17px; opacity: 0.85; max-width: 560px; margin: 0 auto;">欢迎来电咨询或到校参观</p>
  </section>

  <!-- Contact Info + Form -->
  <section class="section">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start;">
        <!-- Left: Info -->
        <div class="fade-in">
          <h2 style="font-family: 'Noto Serif SC', serif; font-size: 28px; margin-bottom: 32px; color: #1e293b;">联系方式</h2>
          
          <div class="card" style="margin-bottom: 20px; display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 48px; height: 48px; background: #eff6ff; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">📍</div>
            <div>
              <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #1e293b;">校区地址</h3>
              <p style="color: #64748b; font-size: 14px;">衡阳市蒸湘区</p>
            </div>
          </div>

          <div class="card" style="margin-bottom: 20px; display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 48px; height: 48px; background: #fff7ed; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">📞</div>
            <div>
              <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #1e293b;">咨询电话</h3>
              <p style="color: #64748b; font-size: 14px;">138-XXXX-XXXX</p>
            </div>
          </div>

          <div class="card" style="margin-bottom: 20px; display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 48px; height: 48px; background: #ecfdf5; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">⏰</div>
            <div>
              <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #1e293b;">营业时间</h3>
              <p style="color: #64748b; font-size: 14px;">周一至周日 8:30 - 20:00</p>
            </div>
          </div>

          <div class="card" style="display: flex; gap: 20px; align-items: flex-start;">
            <div style="width: 48px; height: 48px; background: #faf5ff; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">💬</div>
            <div>
              <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 4px; color: #1e293b;">微信咨询</h3>
              <p style="color: #64748b; font-size: 14px;">扫描下方二维码添加客服</p>
              <div style="width: 120px; height: 120px; background: #f1f5f9; border-radius: 12px; margin-top: 12px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 13px;">二维码占位</div>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="fade-in">
          <div class="card" style="padding: 40px;">
            <h2 style="font-family: 'Noto Serif SC', serif; font-size: 24px; margin-bottom: 8px; color: #1e293b;">在线留言</h2>
            <p style="color: #64748b; font-size: 14px; margin-bottom: 32px;">我们会尽快回复您的咨询</p>
            
            <form style="display: flex; flex-direction: column; gap: 20px;">
              <div>
                <label style="display: block; font-size: 14px; font-weight: 500; color: #475569; margin-bottom: 6px;">姓名</label>
                <input type="text" placeholder="请输入您的姓名" style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 15px; outline: none; transition: border 0.2s; background: #fafafa;" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 500; color: #475569; margin-bottom: 6px;">手机号</label>
                <input type="tel" placeholder="请输入您的手机号" style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 15px; outline: none; transition: border 0.2s; background: #fafafa;" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 500; color: #475569; margin-bottom: 6px;">咨询内容</label>
                <textarea rows="4" placeholder="请描述您的需求..." style="width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 15px; outline: none; resize: vertical; transition: border 0.2s; background: #fafafa; font-family: inherit;"></textarea>
              </div>
              <button type="submit" class="btn btn-primary" style="width: 100%; text-align: center; padding: 14px;">提交留言</button>
            </form>
          </div>
        </div>
      </div>

      <!-- MD Content -->
      <div class="prose fade-in" style="max-width: 800px; margin: 64px auto 0;">
        <Content />
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 768px) {
      [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
    }
  </style>
</Layout>
