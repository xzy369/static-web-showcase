---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const indexContent = pages.find(p => p.data.order === 0);
const { Content } = await render(indexContent);
---

<Layout title="首页">
  <!-- Hero -->
  <section style="background: linear-gradient(160deg, #1e3a5f 0%, #2563eb 50%, #7c3aed 100%); padding: 120px 32px 100px; text-align: center; color: white; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -40%; right: -15%; width: 600px; height: 600px; border-radius: 50%; background: rgba(255,255,255,0.04);"></div>
    <div style="position: absolute; bottom: -30%; left: -10%; width: 500px; height: 500px; border-radius: 50%; background: rgba(255,255,255,0.03);"></div>
    <div style="position: relative; z-index: 1; max-width: 720px; margin: 0 auto;">
      <div style="display: inline-block; padding: 6px 20px; background: rgba(255,255,255,0.15); border-radius: 24px; font-size: 13px; margin-bottom: 28px; backdrop-filter: blur(8px);">🏫 衡阳市教育局批准办学机构</div>
      <h1 style="font-family: 'Noto Serif SC', serif; font-size: 56px; font-weight: 700; margin-bottom: 20px; line-height: 1.2; letter-spacing: -1px;">晨曦文化</h1>
      <p style="font-size: 20px; opacity: 0.9; margin-bottom: 12px; font-weight: 300;">专注初高中衔接 · 培养学习能力</p>
      <p style="font-size: 15px; opacity: 0.7; margin-bottom: 44px; max-width: 520px; margin-left: auto; margin-right: auto; line-height: 1.8;">八年教育初心，以爱育才，以智启航。帮助每一位学生顺利度过初高中衔接的关键时期。</p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/courses" style="display: inline-block; padding: 16px 40px; background: #f97316; color: white; border-radius: 12px; text-decoration: none; font-size: 16px; font-weight: 600; transition: all 0.25s; box-shadow: 0 4px 16px rgba(249,115,22,0.3);">了解课程</a>
        <a href="/contact" style="display: inline-block; padding: 16px 40px; background: rgba(255,255,255,0.12); color: white; border: 1px solid rgba(255,255,255,0.25); border-radius: 12px; text-decoration: none; font-size: 16px; font-weight: 500; backdrop-filter: blur(8px);">联系我们</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding: 48px 32px; background: white; border-bottom: 1px solid #e2e8f0;">
    <div style="max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: center;">
      <div class="fade-in">
        <div style="font-family: 'Noto Serif SC', serif; font-size: 44px; font-weight: 700; color: #2563eb;">8+</div>
        <div style="color: #64748b; font-size: 14px; margin-top: 6px;">年办学经验</div>
      </div>
      <div class="fade-in">
        <div style="font-family: 'Noto Serif SC', serif; font-size: 44px; font-weight: 700; color: #f97316;">2000+</div>
        <div style="color: #64748b; font-size: 14px; margin-top: 6px;">累计服务学生</div>
      </div>
      <div class="fade-in">
        <div style="font-family: 'Noto Serif SC', serif; font-size: 44px; font-weight: 700; color: #2563eb;">95%</div>
        <div style="color: #64748b; font-size: 14px; margin-top: 6px;">家长满意度</div>
      </div>
      <div class="fade-in">
        <div style="font-family: 'Noto Serif SC', serif; font-size: 44px; font-weight: 700; color: #f97316;">15</div>
        <div style="color: #64748b; font-size: 14px; margin-top: 6px;">人/班 最大容量</div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section" style="background: #fafafa;">
    <div class="container">
      <h2 class="section-title fade-in">为什么选择晨曦文化？</h2>
      <p class="section-subtitle fade-in">我们用专业和爱心，为学生的成长保驾护航</p>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        <div class="card fade-in" style="text-align: center;">
          <div style="font-size: 44px; margin-bottom: 20px;">👨‍🏫</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px; color: #1e293b;">专业师资</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">拥有多年教学经验的名师团队，深谙初高中衔接难点，精准教学。</p>
        </div>
        <div class="card fade-in" style="text-align: center;">
          <div style="font-size: 44px; margin-bottom: 20px;">📊</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px; color: #1e293b;">个性诊断</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">入学即进行学习能力评估，量身定制专属学习方案。</p>
        </div>
        <div class="card fade-in" style="text-align: center;">
          <div style="font-size: 44px; margin-bottom: 20px;">👥</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px; color: #1e293b;">小班教学</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">每班不超过15人，确保每位学生得到充分关注和指导。</p>
        </div>
        <div class="card fade-in" style="text-align: center;">
          <div style="font-size: 44px; margin-bottom: 20px;">📈</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px; color: #1e293b;">效果显著</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">学员平均成绩提升30%以上，多位学生考入重点高中。</p>
        </div>
        <div class="card fade-in" style="text-align: center;">
          <div style="font-size: 44px; margin-bottom: 20px;">👨‍👩‍👧</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px; color: #1e293b;">家校联动</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">定期反馈学习进度，家长随时了解孩子成长，共同助力。</p>
        </div>
        <div class="card fade-in" style="text-align: center;">
          <div style="font-size: 44px; margin-bottom: 20px;">🎯</div>
          <h3 style="font-family: 'Noto Serif SC', serif; font-size: 18px; margin-bottom: 10px; color: #1e293b;">精准提分</h3>
          <p style="color: #64748b; font-size: 14px; line-height: 1.8;">针对薄弱环节专项突破，系统化提升学业成绩。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="fade-in" style="padding: 96px 32px; background: linear-gradient(135deg, #1e3a5f, #2563eb); text-align: center; color: white;">
    <h2 style="font-family: 'Noto Serif SC', serif; font-size: 36px; font-weight: 700; margin-bottom: 16px;">开启你的学习新篇章</h2>
    <p style="font-size: 16px; opacity: 0.85; margin-bottom: 40px;">免费试听，无风险体验我们的教学质量</p>
    <a href="/contact" class="btn" style="background: #f97316; color: white; padding: 16px 48px; font-size: 16px; border-radius: 12px; box-shadow: 0 4px 16px rgba(249,115,22,0.3);">立即咨询</a>
  </section>

  <style>
    @media (max-width: 768px) {
      section:first-of-type { padding: 80px 20px 60px !important; }
      section:first-of-type h1 { font-size: 36px !important; }
      section:first-of-type p { font-size: 16px !important; }
      [style*="grid-template-columns: repeat(4"] { grid-template-columns: repeat(2, 1fr) !important; }
      [style*="grid-template-columns: repeat(3"] { grid-template-columns: 1fr !important; }
    }
  </style>
</Layout>
