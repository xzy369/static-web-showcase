---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const pages = await getCollection('pages');
const indexContent = pages.find(p => p.data.order === 0);
const { Content } = await render(indexContent);
---

<Layout title="首页">
  <!-- Hero -->
  <section style="background: linear-gradient(135deg, #1a73e8 0%, #1558b0 50%, #0d47a1 100%); padding: 100px 24px 80px; text-align: center; color: white; position: relative; overflow: hidden;">
    <div style="position: absolute; top: -50%; right: -20%; width: 600px; height: 600px; border-radius: 50%; background: rgba(255,255,255,0.05);"></div>
    <div style="position: absolute; bottom: -30%; left: -10%; width: 400px; height: 400px; border-radius: 50%; background: rgba(255,255,255,0.05);"></div>
    <div style="position: relative; z-index: 1; max-width: 800px; margin: 0 auto;">
      <h1 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; line-height: 1.2;">晨曦文化</h1>
      <p style="font-size: 20px; opacity: 0.9; margin-bottom: 12px;">专注初高中衔接 · 培养学习能力</p>
      <p style="font-size: 16px; opacity: 0.75; margin-bottom: 40px; max-width: 600px; margin-left: auto; margin-right: auto;">八年教育初心，以爱育才，以智启航。帮助每一位学生顺利度过初高中衔接的关键时期。</p>
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/courses" style="display: inline-block; padding: 14px 36px; background: #ff6d00; color: white; border-radius: 8px; text-decoration: none; font-size: 16px; font-weight: 600; transition: all 0.2s;">了解课程</a>
        <a href="/contact" style="display: inline-block; padding: 14px 36px; background: transparent; color: white; border: 2px solid rgba(255,255,255,0.5); border-radius: 8px; text-decoration: none; font-size: 16px; font-weight: 600; transition: all 0.2s;">联系我们</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section style="padding: 60px 24px; background: white;">
    <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: center;">
      <div>
        <div style="font-size: 42px; font-weight: 800; color: #1a73e8;">8+</div>
        <div style="color: #666; font-size: 14px; margin-top: 4px;">年办学经验</div>
      </div>
      <div>
        <div style="font-size: 42px; font-weight: 800; color: #ff6d00;">2000+</div>
        <div style="color: #666; font-size: 14px; margin-top: 4px;">累计服务学生</div>
      </div>
      <div>
        <div style="font-size: 42px; font-weight: 800; color: #1a73e8;">95%</div>
        <div style="color: #666; font-size: 14px; margin-top: 4px;">家长满意度</div>
      </div>
      <div>
        <div style="font-size: 42px; font-weight: 800; color: #ff6d00;">15</div>
        <div style="color: #666; font-size: 14px; margin-top: 4px;">人/班 最大容量</div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section style="padding: 80px 24px; background: #f8f9fa;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h2 style="font-size: 32px; font-weight: 700; text-align: center; margin-bottom: 12px;">为什么选择晨曦文化？</h2>
      <p style="text-align: center; color: #666; font-size: 16px; margin-bottom: 48px;">我们用专业和爱心，为学生的成长保驾护航</p>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; text-align: center; transition: transform 0.2s;">
          <div style="font-size: 40px; margin-bottom: 16px;">👨‍🏫</div>
          <h3 style="font-size: 18px; margin-bottom: 8px; color: #333;">专业师资</h3>
          <p style="color: #666; font-size: 14px; line-height: 1.7;">拥有多年教学经验的名师团队，深谙初高中衔接难点，精准教学。</p>
        </div>
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; text-align: center; transition: transform 0.2s;">
          <div style="font-size: 40px; margin-bottom: 16px;">📊</div>
          <h3 style="font-size: 18px; margin-bottom: 8px; color: #333;">个性诊断</h3>
          <p style="color: #666; font-size: 14px; line-height: 1.7;">入学即进行学习能力评估，量身定制专属学习方案。</p>
        </div>
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; text-align: center; transition: transform 0.2s;">
          <div style="font-size: 40px; margin-bottom: 16px;">👥</div>
          <h3 style="font-size: 18px; margin-bottom: 8px; color: #333;">小班教学</h3>
          <p style="color: #666; font-size: 14px; line-height: 1.7;">每班不超过15人，确保每位学生得到充分关注和指导。</p>
        </div>
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; text-align: center; transition: transform 0.2s;">
          <div style="font-size: 40px; margin-bottom: 16px;">📈</div>
          <h3 style="font-size: 18px; margin-bottom: 8px; color: #333;">效果显著</h3>
          <p style="color: #666; font-size: 14px; line-height: 1.7;">学员平均成绩提升30%以上，多位学生考入重点高中。</p>
        </div>
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; text-align: center; transition: transform 0.2s;">
          <div style="font-size: 40px; margin-bottom: 16px;">👨‍👩‍👧</div>
          <h3 style="font-size: 18px; margin-bottom: 8px; color: #333;">家校联动</h3>
          <p style="color: #666; font-size: 14px; line-height: 1.7;">定期反馈学习进度，家长随时了解孩子成长，共同助力。</p>
        </div>
        <div style="background: white; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; text-align: center; transition: transform 0.2s;">
          <div style="font-size: 40px; margin-bottom: 16px;">🎯</div>
          <h3 style="font-size: 18px; margin-bottom: 8px; color: #333;">精准提分</h3>
          <p style="color: #666; font-size: 14px; line-height: 1.7;">针对薄弱环节专项突破，系统化提升学业成绩。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding: 80px 24px; background: linear-gradient(135deg, #1a73e8, #0d47a1); text-align: center; color: white;">
    <h2 style="font-size: 32px; font-weight: 700; margin-bottom: 16px;">开启你的学习新篇章</h2>
    <p style="font-size: 16px; opacity: 0.85; margin-bottom: 32px;">免费试听，无风险体验我们的教学质量</p>
    <a href="/contact" style="display: inline-block; padding: 14px 40px; background: #ff6d00; color: white; border-radius: 8px; text-decoration: none; font-size: 16px; font-weight: 600;">立即咨询</a>
  </section>

  <script>
    if (window.innerWidth <= 768) {
      const grids = document.querySelectorAll('[style*="grid-template-columns"]');
      grids.forEach(grid => {
        const style = grid.getAttribute('style') || '';
        if (style.includes('repeat(4')) grid.style.gridTemplateColumns = 'repeat(2, 1fr)';
        if (style.includes('repeat(3')) grid.style.gridTemplateColumns = '1fr';
      });
    }
  </script>
</Layout>
